      <!-- R4/R5 boundary (y=6.75): col=4 loop trap -->
      <link name="wall_h45_col4">
        <pose>5.25 6.75 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.5 0.15 1.5</size></box></geometry>
