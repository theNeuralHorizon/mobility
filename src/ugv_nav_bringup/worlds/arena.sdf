          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- R4/R5 boundary (y=6.75): col=1 -->
      <link name="wall_h45_col1">
        <pose>0.75 6.75 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.35 0.15 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.35 0.15 1.5</size></box></geometry>
          <material>
