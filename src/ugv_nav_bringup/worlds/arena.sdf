        </visual>
      </link>

      <!-- R3/R4 boundary (y=5.25): col=5 -->
      <link name="wall_h34_col5">
        <pose>6.75 5.25 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.5 0.15 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
