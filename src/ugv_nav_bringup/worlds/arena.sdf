    <!-- ============================================================ -->
    <!-- ArUco markers FLUSH ON WALLS at camera height                 -->
    <!-- ============================================================ -->
    <!-- ArUco 0: on south wall of cell(2,1), faces north into corridor -->
    <model name="aruco_0"><static>true</static>
      <pose>5.0 2.08 0.12 -1.5708 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.3 0.3 0.005</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link>
    </model>
    <!-- ArUco 1: on south wall of cell(4,0), faces north near goal -->
    <model name="aruco_1"><static>true</static>
      <pose>9.0 0.08 0.12 -1.5708 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.3 0.3 0.005</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link>
    </model>
    <!-- ArUco 2: on north wall of cell(1,4), faces south from top -->
    <model name="aruco_2"><static>true</static>
      <pose>3.0 9.92 0.12 1.5708 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.3 0.3 0.005</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link>
    </model>
    <!-- ArUco 3: on west wall of cell(3,2), faces east into corridor -->
    <model name="aruco_3"><static>true</static>
      <pose>6.08 5.0 0.12 0 1.5708 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.3 0.3 0.005</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link>
    </model>

    <!-- ============================================================ -->
    <!-- Directional signs at EVERY decision point                     -->
    <!-- Guide the robot through: Start -> ArUco0 -> ArUco3 ->        -->
    <!--   ArUco1 -> Goal                                              -->
    <!-- ============================================================ -->

    <!-- Sign 1: FORWARD at start, guide robot north from cell(0,0) -->
    <model name="sign_fwd_1"><static>true</static>
      <pose>1.0 1.5 0 0 0 0</pose>
      <link name="post">
        <visual name="post_v"><geometry><cylinder><radius>0.015</radius><length>0.2</length></cylinder></geometry>
          <pose>0 0 0.1 0 0 0</pose>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
        <visual name="face_v"><geometry><box><size>0.2 0.2 0.005</size></box></geometry>
          <pose>0 0 0.22 0 0 0</pose>
          <material><ambient>0 0.8 0.8 1</ambient><diffuse>0 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Sign 2: RIGHT at cell(0,1), guide robot east -->
    <model name="sign_right_1"><static>true</static>
      <pose>1.0 3.0 0 0 0 0</pose>
      <link name="post">
        <visual name="post_v"><geometry><cylinder><radius>0.015</radius><length>0.2</length></cylinder></geometry>
          <pose>0 0 0.1 0 0 0</pose>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
        <visual name="face_v"><geometry><box><size>0.2 0.2 0.005</size></box></geometry>
          <pose>0 0 0.22 0 0 0</pose>
          <material><ambient>0 0 0.8 1</ambient><diffuse>0 0 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Sign 3: FORWARD at cell(1,1), guide robot east toward ArUco0 -->
    <model name="sign_fwd_2"><static>true</static>
      <pose>3.0 3.0 0 0 0 0</pose>
      <link name="post">
        <visual name="post_v"><geometry><cylinder><radius>0.015</radius><length>0.2</length></cylinder></geometry>
          <pose>0 0 0.1 0 0 0</pose>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
        <visual name="face_v"><geometry><box><size>0.2 0.2 0.005</size></box></geometry>
          <pose>0 0 0.22 0 0 0</pose>
          <material><ambient>0 0.8 0.8 1</ambient><diffuse>0 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Sign 4: FORWARD at cell(2,1), past ArUco0, continue east -->
    <model name="sign_fwd_3"><static>true</static>
      <pose>5.0 3.0 0 0 0 0</pose>
      <link name="post">
        <visual name="post_v"><geometry><cylinder><radius>0.015</radius><length>0.2</length></cylinder></geometry>
          <pose>0 0 0.1 0 0 0</pose>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
        <visual name="face_v"><geometry><box><size>0.2 0.2 0.005</size></box></geometry>
