    <!-- ============================================================== -->
    <!-- ArUco markers ON wall surfaces, camera height z=0.15           -->
    <!-- ============================================================== -->

    <!-- aruco_0: On south face of horizontal wall at y=4, x=1.0       -->
    <!-- Robot must explore north to cell(0,1) area to see it         -->
    <model name="aruco_0"><static>true</static>
      <pose>1.0 3.925 0.15 0 0 0.0000</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.3 0.01 0.3</size></box></geometry>
        <material><diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>../textures/aruco_0.png</albedo_map>
          </metal></pbr>
        </material></visual></link>
    </model>

    <!-- aruco_1: On west face of vertical wall at x=6, y=3.0         -->
    <!-- Robot must reach cell(2,1) area to see it                     -->
    <model name="aruco_1"><static>true</static>
      <pose>5.925 3.0 0.15 0 0 1.5708</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.3 0.01 0.3</size></box></geometry>
        <material><diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>../textures/aruco_1.png</albedo_map>
          </metal></pbr>
        </material></visual></link>
    </model>

    <!-- aruco_2: On south face of horizontal wall at y=4, near x=7   -->
    <!-- Robot travels north in cell(3,1), sees this on wall ahead     -->
    <model name="aruco_2"><static>true</static>
      <pose>7.0 3.925 0.15 0 0 0.0000</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.3 0.01 0.3</size></box></geometry>
        <material><diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>../textures/aruco_2.png</albedo_map>
          </metal></pbr>
        </material></visual></link>
    </model>

    <!-- aruco_3: On west face of vertical wall at x=10, near y=5     -->
    <!-- Robot travels east in cell(4,2), sees this on wall ahead      -->
    <model name="aruco_3"><static>true</static>
      <pose>9.925 5.0 0.15 0 0 1.5708</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.3 0.01 0.3</size></box></geometry>
        <material><diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>../textures/aruco_3.png</albedo_map>
          </metal></pbr>
        </material></visual></link>
    </model>

    <!-- ============================================================== -->
    <!-- Direction signs — path visits ALL 4 ArUco markers              -->
    <!-- Path: (0,0)N>(0,1)[A0] S>(0,0)E>(1,0)N>(1,1)E>(2,1)[A1]     -->
    <!--   N>(2,2)E>(3,2)E>(4,2)[A3] S>(4,1)W>(3,1)[A2] E>(4,1)      -->
    <!--   E>(5,1)S>(5,0)[GOAL]                                        -->
    <!-- ============================================================== -->

    <!-- Colors: FORWARD=cyan, RIGHT=blue, LEFT=green, STOP=red, GOAL=orange -->
    <!-- Signs offset 0.3m from walls so bot can pass                   -->

    <!-- 1. FORWARD — start toward aruco_0 (faces east so robot sees it from spawn) -->
    <model name="sign_forward_1"><static>true</static>
      <pose>0.3 1.5 0 0 0 0</pose>
      <link name="post">
        <collision name="post_col"><geometry><cylinder><radius>0.03</radius><length>0.20</length></cylinder></geometry>
          <pose>0 0 0.10 0 0 0</pose>
        </collision>
        <visual name="post"><geometry><cylinder><radius>0.01</radius><length>0.12</length></cylinder></geometry>
          <pose>0 0 0.06 0 0 0</pose>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
      <link name="sign">
        <visual name="face"><geometry><box><size>0.20 0.01 0.15</size></box></geometry>
          <pose>0 0 0.10 0 0 0.0000</pose>
          <material><ambient>0 0.8 0.8 1</ambient><diffuse>0 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 2. FORWARD — return from dead end -->
    <model name="sign_forward_2"><static>true</static>
      <pose>0.3 2.5 0 0 0 0</pose>
      <link name="post">
        <collision name="post_col"><geometry><cylinder><radius>0.03</radius><length>0.20</length></cylinder></geometry>
          <pose>0 0 0.10 0 0 0</pose>
        </collision>
        <visual name="post"><geometry><cylinder><radius>0.01</radius><length>0.12</length></cylinder></geometry>
          <pose>0 0 0.06 0 0 0</pose>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
      <link name="sign">
        <visual name="face"><geometry><box><size>0.20 0.01 0.15</size></box></geometry>
          <pose>0 0 0.10 0 0 1.5708</pose>
          <material><ambient>0 0.8 0.8 1</ambient><diffuse>0 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 3. RIGHT — head east after return -->
    <model name="sign_right_1"><static>true</static>
      <pose>1.5 0.3 0 0 0 0</pose>
      <link name="post">
        <collision name="post_col"><geometry><cylinder><radius>0.03</radius><length>0.20</length></cylinder></geometry>
          <pose>0 0 0.10 0 0 0</pose>
        </collision>
        <visual name="post"><geometry><cylinder><radius>0.01</radius><length>0.12</length></cylinder></geometry>
          <pose>0 0 0.06 0 0 0</pose>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
      <link name="sign">
        <visual name="face"><geometry><box><size>0.20 0.01 0.15</size></box></geometry>
          <pose>0 0 0.10 0 0 -1.5708</pose>
          <material><ambient>0 0 0.8 1</ambient><diffuse>0 0 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 4. FORWARD — toward cell(1,1) -->
    <model name="sign_forward_3"><static>true</static>
      <pose>2.3 1.5 0 0 0 0</pose>
      <link name="post">
        <collision name="post_col"><geometry><cylinder><radius>0.03</radius><length>0.20</length></cylinder></geometry>
          <pose>0 0 0.10 0 0 0</pose>
        </collision>
