<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="ugv_arena">

    <!-- ============================================================ -->
    <!--  Plugins                                                      -->
    <!-- ============================================================ -->
    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics">
    </plugin>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands">
    </plugin>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="ignition-gazebo-imu-system"
            name="ignition::gazebo::systems::Imu">
    </plugin>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-contact-system"
            name="ignition::gazebo::systems::Contact">
    </plugin>

    <!-- ============================================================ -->
    <!--  Scene & Lighting                                             -->
    <!-- ============================================================ -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.8 0.95 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.3 -0.9</direction>
    </light>

    <light type="directional" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.4 0.4 0.4 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.5 -0.3 -0.8</direction>
    </light>

    <!-- ============================================================ -->
    <!--  Ground Plane                                                 -->
    <!-- ============================================================ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!--  Zone Floor Markings                                          -->
    <!-- ============================================================ -->

    <!-- Start zone: green floor at (0, 0) -->
    <model name="start_zone">
      <static>true</static>
      <pose>0 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>1.2 1.2 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.1 0.7 0.1 1</ambient>
            <diffuse>0.15 0.8 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- True goal zone: gold floor at (9.0, 0.75) -->
    <model name="true_goal_zone">
      <static>true</static>
      <pose>9.0 0.75 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>1.2 1.2 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.85 0.65 0.0 1</ambient>
            <diffuse>0.95 0.75 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- False goal zone: similar gold at (9.0, 3.0) -->
    <model name="false_goal_zone">
      <static>true</static>
      <pose>9.0 3.0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>1.2 1.2 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.80 0.60 0.0 1</ambient>
            <diffuse>0.90 0.70 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- T-junction marking at col=3, row=3 -> (3.75, 3.75) -->
    <model name="t_junction_1">
      <static>true</static>
      <pose>3.75 3.75 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.6 0.6 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.6 1</ambient>
            <diffuse>0.4 0.4 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- T-junction marking at col=5, row=3 -> (6.75, 3.75) -->
    <model name="t_junction_2">
      <static>true</static>
      <pose>6.75 3.75 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.6 0.6 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.6 1</ambient>
            <diffuse>0.4 0.4 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!--  Arena Walls (single model, multiple links)                   -->
    <!--                                                               -->
    <!--  Grid: 8 cols (0-7) x 6 rows (0-5), each cell 1.5m x 1.5m   -->
    <!--  Arena spans x: [-1.5, 10.5], y: [-1.5, 7.5]                 -->
    <!--  Coordinate: x = col*1.5 - 0.75, y = row*1.5 - 0.75         -->
    <!--                                                               -->
    <!--  Horizontal walls: length along X, no rotation               -->
    <!--  Vertical walls:   length along Y, rotation 1.5708 (90 deg) -->
    <!--  Wall thickness: 0.15m, height: 1.5m                         -->
    <!-- ============================================================ -->
    <model name="arena_walls">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>

      <!-- ========== OUTER BOUNDARY ========== -->

      <!-- Bottom wall: y = -1.5, length = 12.15 (with overlap) -->
      <link name="wall_outer_bottom">
        <pose>4.5 -1.5 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>12.15 0.15 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.15 0.15 1.5</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Top wall: y = 7.5 -->
      <link name="wall_outer_top">
        <pose>4.5 7.5 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>12.15 0.15 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.15 0.15 1.5</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Left wall: x = -1.5, length = 9.15 (with overlap) -->
      <link name="wall_outer_left">
        <pose>-1.5 3.0 0.75 0 0 1.5708</pose>
        <collision name="collision">
          <geometry><box><size>9.15 0.15 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>9.15 0.15 1.5</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Right wall: x = 10.5 -->
      <link name="wall_outer_right">
        <pose>10.5 3.0 0.75 0 0 1.5708</pose>
        <collision name="collision">
          <geometry><box><size>9.15 0.15 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>9.15 0.15 1.5</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- ========== INTERNAL HORIZONTAL WALLS ========== -->

      <!-- R0/R1 boundary (y=0.75): col=0 left portion -->
      <link name="wall_h01_a">
        <pose>-0.75 0.75 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.5 0.15 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 0.15 1.5</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- R0/R1 boundary (y=0.75): col=4 to col=5 -->
      <link name="wall_h01_col45">
        <pose>6.75 0.75 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>3.0 0.15 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.0 0.15 1.5</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- R1/R2 boundary (y=2.25): col=2 -->
      <link name="wall_h12_col2">
        <pose>2.25 2.25 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.5 0.15 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 0.15 1.5</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
