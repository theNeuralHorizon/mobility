    </model>

    <!-- ============================================================== -->
    <!-- Direction signs along intended path                            -->
    <!-- Path: (0,0)>(1,0)>(1,1)>(2,1)>(2,2)>(3,2)>(4,2)>(4,1)>(5,1)>(5,0) -->
    <!-- ============================================================== -->

    <!-- 1. FORWARD at start zone — go north from (0,0) toward (0,1) -->
    <model name="sign_fwd_start"><static>true</static>
      <pose>1.0 1.5 0 0 0 0</pose>
      <link name="post">
        <visual name="post"><geometry><cylinder><radius>0.02</radius><length>0.25</length></cylinder></geometry>
          <pose>0 0 0.125 0 0 0</pose>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
      <link name="sign">
        <visual name="face"><geometry><box><size>0.25 0.25 0.01</size></box></geometry>
          <pose>0 0 0.28 0 0 0</pose>
          <material><diffuse>0 0.8 0.8 1</diffuse>
            <pbr><metal>
              <albedo_map>../textures/sign_forward.png</albedo_map>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- 2. FORWARD east along row 0 — in cell(0,0) east side -->
