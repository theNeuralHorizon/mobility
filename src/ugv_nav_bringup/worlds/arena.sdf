          <material><ambient>0 0.8 0.8 1</ambient><diffuse>0 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Sign 5: RIGHT at cell(3,1), guide south toward ArUco3 area -->
    <model name="sign_right_2"><static>true</static>
      <pose>7.0 3.0 0 0 0 0</pose>
      <link name="post">
        <visual name="post_v"><geometry><cylinder><radius>0.015</radius><length>0.2</length></cylinder></geometry>
          <pose>0 0 0.1 0 0 0</pose>
