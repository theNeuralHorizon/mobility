        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 0.15 1.5</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- R1/R2 boundary (y=2.25): col=5 -->
      <link name="wall_h12_col5">
        <pose>6.75 2.25 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.5 0.15 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 0.15 1.5</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- R2/R3 boundary (y=3.75): col=3-4 -->
      <link name="wall_h23_col34">
        <pose>5.25 3.75 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.5 0.15 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 0.15 1.5</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- R2/R3 boundary (y=3.75): col=6 false goal enclosure top -->
      <link name="wall_h23_col6">
        <pose>8.25 3.75 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.5 0.15 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 0.15 1.5</size></box></geometry>
          <material>
