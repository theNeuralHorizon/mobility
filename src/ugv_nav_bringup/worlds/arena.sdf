        </visual>
      </link>

      <!-- ========== INTERNAL VERTICAL WALLS (N-S, rotated 90deg) ========== -->

      <!-- col0/col1 boundary (x=0.75): rows 2-5 dead end corridor -->
      <link name="wall_v01_upper">
        <pose>0.75 5.25 0.75 0 0 1.5708</pose>
        <collision name="collision">
          <geometry><box><size>4.5 0.15 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.5 0.15 1.5</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- col1/col2 boundary (x=2.25): rows 0-1 -->
      <link name="wall_v12_lower">
        <pose>2.25 0.0 0.75 0 0 1.5708</pose>
        <collision name="collision">
          <geometry><box><size>3.0 0.15 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
