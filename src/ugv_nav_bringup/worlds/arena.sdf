        </visual>
        <visual name="face_v"><geometry><box><size>0.2 0.2 0.005</size></box></geometry>
          <pose>0 0 0.22 0 0 0</pose>
          <material><ambient>0 0.8 0 1</ambient><diffuse>0 0.8 0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Sign 8: STOP near false goal cell(4,3) -->
    <model name="sign_stop"><static>true</static>
      <pose>9.0 7.0 0 0 0 0</pose>
      <link name="post">
        <visual name="post_v"><geometry><cylinder><radius>0.015</radius><length>0.2</length></cylinder></geometry>
          <pose>0 0 0.1 0 0 0</pose>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
        <visual name="face_v"><geometry><box><size>0.2 0.2 0.005</size></box></geometry>
          <pose>0 0 0.22 0 0 0</pose>
