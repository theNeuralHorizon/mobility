<?xml version='1.0' encoding='utf-8'?>
<sdf version='1.9'>
  <world name='ugv_challenge_arena'>

    <!-- ============================================================ -->
    <!--  Physics                                                      -->
    <!-- ============================================================ -->
    <physics name='1ms' type='ignored'>
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- ============================================================ -->
    <!--  Required Plugins                                             -->
    <!-- ============================================================ -->
    <plugin name='ignition::gazebo::systems::Physics'
            filename='libignition-gazebo-physics-system.so'/>
    <plugin name='ignition::gazebo::systems::UserCommands'
            filename='libignition-gazebo-user-commands-system.so'/>
    <plugin name='ignition::gazebo::systems::SceneBroadcaster'
            filename='libignition-gazebo-scene-broadcaster-system.so'/>
    <plugin name='ignition::gazebo::systems::Imu'
            filename='ignition-gazebo-imu-system'/>
    <plugin name='ignition::gazebo::systems::Sensors'
            filename='ignition-gazebo-sensors-system'>
      <render_engine>ogre</render_engine>
    </plugin>
    <plugin name='ignition::gazebo::systems::Contact'
            filename='libignition-gazebo-contact-system.so'/>

    <!-- ============================================================ -->
    <!--  Scene                                                        -->
    <!-- ============================================================ -->
    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.3 0.7 0.9 1</background>
      <shadows>true</shadows>
      <grid>true</grid>
    </scene>

    <!-- ============================================================ -->
    <!--  Sun                                                          -->
    <!-- ============================================================ -->
    <light type='directional' name='sun'>
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.5 -1.0</direction>
    </light>

    <!-- ============================================================ -->
    <!--  Ground Plane                                                 -->
    <!-- ============================================================ -->
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 16</size>
            </plane>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 16</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!--  ZONE FLOOR PATCHES                                           -->
    <!-- ============================================================ -->

    <!-- START ZONE floor (green) at origin -->
    <model name='start_zone_floor'>
      <static>true</static>
      <pose>0 0 0.005 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>1.5 1.5 0.01</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>1.5 1.5 0.01</size></box></geometry>
          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
            <diffuse>0.2 0.8 0.2 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- TRUE GOAL ZONE floor (gold) at (10, 0) -->
    <model name='goal_zone_floor'>
      <static>true</static>
      <pose>10 0 0.005 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>1.5 1.5 0.01</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>1.5 1.5 0.01</size></box></geometry>
          <material>
            <ambient>0.9 0.7 0.1 1</ambient>
            <diffuse>0.9 0.7 0.1 1</diffuse>
            <specular>0.2 0.2 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- FALSE GOAL ZONE floor (slightly different gold) at (3, -5) -->
    <model name='false_goal_zone_floor'>
      <static>true</static>
      <pose>3 -5 0.005 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>1.5 1.5 0.01</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>1.5 1.5 0.01</size></box></geometry>
          <material>
            <ambient>0.8 0.6 0.1 1</ambient>
            <diffuse>0.8 0.6 0.1 1</diffuse>
            <specular>0.15 0.15 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

