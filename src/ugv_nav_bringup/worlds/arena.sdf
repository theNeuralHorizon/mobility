<?xml version='1.0' encoding='utf-8'?>
<sdf version='1.9'>
  <world name='ugv_challenge_arena'>

    <!-- ============================================================ -->
    <!--  Physics                                                      -->
    <!-- ============================================================ -->
    <physics name='1ms' type='ignored'>
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- ============================================================ -->
    <!--  Required Plugins                                             -->
    <!-- ============================================================ -->
    <plugin name='ignition::gazebo::systems::Physics'
            filename='libignition-gazebo-physics-system.so'/>
    <plugin name='ignition::gazebo::systems::UserCommands'
            filename='libignition-gazebo-user-commands-system.so'/>
    <plugin name='ignition::gazebo::systems::SceneBroadcaster'
            filename='libignition-gazebo-scene-broadcaster-system.so'/>
    <plugin name='ignition::gazebo::systems::Imu'
            filename='ignition-gazebo-imu-system'/>
    <plugin name='ignition::gazebo::systems::Sensors'
            filename='ignition-gazebo-sensors-system'>
      <render_engine>ogre</render_engine>
    </plugin>
    <plugin name='ignition::gazebo::systems::Contact'
            filename='libignition-gazebo-contact-system.so'/>

    <!-- ============================================================ -->
    <!--  Scene                                                        -->
    <!-- ============================================================ -->
    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.3 0.7 0.9 1</background>
      <shadows>true</shadows>
      <grid>true</grid>
    </scene>

    <!-- ============================================================ -->
    <!--  Sun                                                          -->
    <!-- ============================================================ -->
    <light type='directional' name='sun'>
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.5 -1.0</direction>
    </light>

    <!-- ============================================================ -->
    <!--  Ground Plane                                                 -->
    <!-- ============================================================ -->
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 16</size>
            </plane>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 16</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!--  ZONE FLOOR PATCHES                                           -->
    <!-- ============================================================ -->

    <!-- START ZONE floor (green) at origin -->
    <model name='start_zone_floor'>
      <static>true</static>
      <pose>0 0 0.005 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>1.5 1.5 0.01</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>1.5 1.5 0.01</size></box></geometry>
          <material>
            <ambient>0.0 0.6 0.0 1</ambient>
            <diffuse>0.0 0.8 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- TRUE GOAL ZONE floor (gold) -->
    <model name='true_goal_floor'>
      <static>true</static>
      <pose>8 -3 0.005 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>1.0 1.0 0.01</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>1.0 1.0 0.01</size></box></geometry>
          <material>
            <ambient>0.8 0.65 0.0 1</ambient>
            <diffuse>1.0 0.84 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- FALSE GOAL ZONE floor (similar gold - trap) -->
    <model name='false_goal_floor'>
      <static>true</static>
      <pose>9 -3 0.005 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>1.0 1.0 0.01</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>1.0 1.0 0.01</size></box></geometry>
          <material>
            <ambient>0.75 0.6 0.0 1</ambient>
            <diffuse>0.95 0.8 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!--  OUTER PERIMETER WALLS (10m x 8m box, no gaps)                -->
    <!--  Arena spans x: -1 to 9, y: -4 to 4                          -->
    <!--  Wall thickness: 0.15m, height: 1.0m                         -->
    <!--  All walls placed at z=0.5 (half height)                     -->
    <!-- ============================================================ -->

    <!-- BOTTOM wall: y=-4, from x=-1 to x=9 (length=10.15) -->
    <model name='wall_bottom'>
      <static>true</static>
      <pose>4 -4.25 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>11.0 0.5 1.0</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>11.0 0.5 1.0</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- TOP wall: y=4, from x=-1 to x=9 (length=10.15) -->
    <model name='wall_top'>
      <static>true</static>
      <pose>4 4.25 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>11.0 0.5 1.0</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>11.0 0.5 1.0</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- LEFT wall: x=-1, from y=-4 to y=4 (length=8.15) -->
    <model name='wall_left'>
      <static>true</static>
      <pose>-1.25 0 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>0.5 9.0 1.0</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.5 9.0 1.0</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- RIGHT wall: x=9, from y=-4 to y=4 (length=8.15) -->
    <model name='wall_right'>
      <static>true</static>
      <pose>9.25 0 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>0.5 9.0 1.0</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.5 9.0 1.0</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!--  INTERNAL WALLS                                               -->
    <!--  Grid-based layout ensuring all walls connect                 -->
    <!-- ============================================================ -->

    <!-- === Start zone enclosure (left column, y=-1 to y=4) === -->

    <!-- Vertical wall: x=1, from y=2 to y=4 (separates start zone upper from corridor) -->
    <model name='wall_start_right_upper'>
      <static>true</static>
      <pose>1 3 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>0.15 2.0 1.0</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.15 2.0 1.0</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Horizontal wall: y=2, from x=-1 to x=0.5 (gap at x=0.5 to x=1 for passage) -->
    <model name='wall_start_mid_left'>
      <static>true</static>
      <pose>-0.25 2 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>1.65 0.15 1.0</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>1.65 0.15 1.0</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Vertical wall: x=1, from y=-1 to y=1.5 (start zone right lower) -->
    <model name='wall_start_right_lower'>
      <static>true</static>
      <pose>1 0.64 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>0.15 1.87 1.0</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.15 1.87 1.0</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Horizontal wall: y=-1, from x=-1 to x=1 (bottom of start zone) -->
    <!-- Gap between x=0.3 and x=0.7 for passage out -->
    <model name='wall_start_bottom_left'>
      <static>true</static>
      <pose>-0.625 -1 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>1.05 0.15 1.0</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>1.05 0.15 1.0</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- === Dead end corridor: from (-0.5,2) up to (-0.5,3.5) blocked === -->
    <!-- The left wall + wall_start_mid_left + wall_top already form this -->
    <!-- Add a blocking wall at y=3.5, x=-1 to x=0.5 to seal dead end -->
    <model name='wall_deadend_block'>
      <static>true</static>
      <pose>-0.25 3.5 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>1.65 0.15 1.0</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>1.65 0.15 1.0</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- === Central horizontal divider: y=2, from x=1.5 to x=6 === -->
    <model name='wall_central_h'>
      <static>true</static>
      <pose>3.75 2 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>4.65 0.15 1.0</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>4.65 0.15 1.0</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- === Right section top divider: y=2, from x=6 to x=9 === -->
    <model name='wall_right_top_h'>
      <static>true</static>
      <pose>7.5 2 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>3.15 0.15 1.0</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>3.15 0.15 1.0</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- === Vertical wall separating upper-left from upper-center: x=3, y=2 to y=4 === -->
    <model name='wall_upper_div1'>
      <static>true</static>
      <pose>3 3 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>0.15 2.0 1.0</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.15 2.0 1.0</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- === Vertical wall separating upper-center from loop trap: x=6, y=2 to y=4 === -->
    <model name='wall_upper_div2'>
      <static>true</static>
      <pose>6 3 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>0.15 2.0 1.0</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.15 2.0 1.0</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- === Loop trap internal walls === -->
    <!-- Horizontal wall inside loop: y=3, from x=7 to x=9 -->
    <model name='wall_loop_mid'>
      <static>true</static>
      <pose>8 3 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>2.0 0.15 1.0</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>2.0 0.15 1.0</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Vertical wall in loop: x=7, y=2 to y=3 (creates the loop-back) -->
    <model name='wall_loop_inner'>
      <static>true</static>
      <pose>7 2.5 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>0.15 1.15 1.0</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.15 1.15 1.0</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- === Maze corridor walls (lower section, y=-1 to y=2) === -->

    <!-- Vertical wall: x=2, from y=-1 to y=1.5 -->
    <model name='wall_maze_v1'>
      <static>true</static>
      <pose>2 0.25 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>0.15 2.65 1.0</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.15 2.65 1.0</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Horizontal wall: y=-1, from x=2 to x=7 -->
    <model name='wall_maze_h1'>
      <static>true</static>
      <pose>4.5 -1 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>5.15 0.15 1.0</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>5.15 0.15 1.0</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Gap at x=7 to x=7.5 in y=-1 wall for passage to lower section -->

    <!-- Horizontal wall: y=-1, from x=7.5 to x=9 -->
    <model name='wall_maze_h1_right'>
      <static>true</static>
      <pose>8.25 -1 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>1.65 0.15 1.0</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>1.65 0.15 1.0</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Vertical wall: x=4, from y=-1 to y=0.5 (creates corridor split) -->
    <model name='wall_maze_v2'>
      <static>true</static>
      <pose>4 -0.25 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>0.15 1.65 1.0</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.15 1.65 1.0</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Horizontal wall: y=1, from x=3 to x=6 (upper corridor boundary) -->
    <model name='wall_maze_h2'>
      <static>true</static>
      <pose>4.5 1 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>3.15 0.15 1.0</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>3.15 0.15 1.0</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- === Lower section walls (y=-4 to y=-1) === -->

    <!-- Horizontal wall: y=-2, from x=-1 to x=5 -->
    <model name='wall_lower_h1'>
      <static>true</static>
      <pose>2 -2 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>6.15 0.15 1.0</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>6.15 0.15 1.0</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Vertical wall: x=5, from y=-4 to y=-2 (separates S2 area from S3 area) -->
    <model name='wall_lower_v1'>
      <static>true</static>
      <pose>5 -3 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>0.15 2.15 1.0</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.15 2.15 1.0</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Horizontal wall: y=-2, from x=5 to x=7.5 (upper boundary of S3 area) -->
    <model name='wall_lower_h2'>
      <static>true</static>
      <pose>6.25 -2 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>2.65 0.15 1.0</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>2.65 0.15 1.0</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Vertical wall: x=7.5, from y=-4 to y=-2 (separates goal from false goal) -->
    <model name='wall_goal_div'>
      <static>true</static>
      <pose>7.5 -3 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>0.15 2.15 1.0</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.15 2.15 1.0</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Vertical wall: x=8.5, from y=-4 to y=-1 (right side of goal corridor) -->
    <model name='wall_goal_right'>
      <static>true</static>
      <pose>8.5 -2.5 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>0.15 3.15 1.0</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.15 3.15 1.0</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!--  ARUCO MARKER PLACEHOLDERS (white 0.3x0.3x0.01 boxes)       -->
    <!-- ============================================================ -->

    <!-- ArUco 0: at (-0.5, 3, 0.5) on wall, facing south (rotation about Z by pi) -->
    <model name='aruco_marker_0'>
      <static>true</static>
      <pose>-0.5 3 0.5 0 0 3.14159</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry><box><size>0.3 0.3 0.01</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ArUco 1: at (2, -3.5, 0.5) on wall, facing north -->
    <model name='aruco_marker_1'>
      <static>true</static>
      <pose>2 -3.5 0.5 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry><box><size>0.3 0.3 0.01</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
