      <!-- Dead end cap: top of col=0 dead-end corridor -->
      <link name="wall_deadend_cap">
        <pose>-0.75 6.75 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.5 0.15 1.5</size></box></geometry>
