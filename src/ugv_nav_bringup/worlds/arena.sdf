    </model>
    <!-- Sign 6: FORWARD at cell(3,0), guide east toward goal -->
    <model name="sign_fwd_4"><static>true</static>
      <pose>7.0 1.0 0 0 0 0</pose>
      <link name="post">
        <visual name="post_v"><geometry><cylinder><radius>0.015</radius><length>0.2</length></cylinder></geometry>
